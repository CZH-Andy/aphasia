# 失语症语言康复系统 — 环境变量模板
# 复制此文件为 .env，填入实际值后启动服务
# .env 文件已被 .gitignore 排除，请勿将真实密钥提交到 Git

# ========== Java 后端 (application.properties) ==========

# 阿里云 Qwen API（用于文本补全/翻译）
LLM_API_KEY=

# 百度 OCR API
BAIDU_APP_ID=
BAIDU_API_KEY=
BAIDU_CLIENT_SECRET=

# 讯飞 ASR/TTS API
FLYTEK_APP_ID=
FLYTEK_API_KEY=
FLYTEK_CLIENT_SECRET=

# MongoDB 认证凭据
MONGO_USERNAME=zsb
MONGO_PASSWORD=

# Redis 密码
REDIS_PASSWORD=

# JWT 签名密钥（生产环境请使用随机生成的强密钥，至少 32 字符）
JWT_SECRET=

# 可选：媒体短期 URL 使用独立 HMAC 密钥（至少 32 字节）；不填时复用 JWT_SECRET
# MEDIA_SIGNING_SECRET=

# 媒体签名 URL 有效期，默认 3600 秒，允许 1~86400
# MEDIA_URL_TTL_SECONDS=3600

# CORS 允许的前端域名（生产环境替换，多个用逗号分隔）
# APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://your-domain.com
# APP_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# 后端主机名，用于拼接给前端的静态资源 URL（音频/图片）
# 默认 localhost；部署到云/局域网时改为对应域名或 IP
# APP_HOST=api.example.com

# 生产推荐配置完整 HTTPS 基础地址，优先级高于 APP_HOST
# APP_PUBLIC_BASE_URL=https://api.example.com

# 上传媒体根目录。Docker Compose 已固定为 /app/media 并挂载 media-data 卷；
# 裸进程默认使用当前工作目录，无需设置。
# MEDIA_ROOT=/srv/aphasia/media

# ========== Python LLM 模块 (LLM/siliconflow.py) ==========

# SiliconFlow API Key（用于 DeepSeek-V3 诊断与修复）
SILICONFLOW_API_KEY=

# LLM 模块路径（默认自动使用脚本所在目录，跨平台部署时可覆盖）
# LLM_PATH=/path/to/LLM/

# FastAPI 微服务地址（Java 后端通过此 URL 调用 Python LLM 服务）
LLM_SERVICE_URL=http://127.0.0.1:8001
